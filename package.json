{
  "name": "daily-practice-sheet",
  "version": "1.0.0",
  "description": "Generate a daily practice sheet for a selection of various topics.",
  "license": "MIT",
  "author": "Hillary Spratt",
  "sourceType": "module",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:build": "node build.js --watch",
    "dev:server": "servor dist index.html 3000 --reload",
    "dev:types": "tsc --watch --noEmit",
    "dev": "concurrently --kill-others -n \"BUILD,SERVE,TYPES\" -c \"cyan,green,magenta\" \"npm:dev:build\" \"npm:dev:server\" \"npm:dev:types\"",
    "build:geo": "ts-node scripts/compile-geography.ts",
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --minify --sourcemap"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-dsv": "^3.0.7",
    "@types/jsdom": "^30.0.0",
    "concurrently": "^10.0.5",
    "d3": "^7.9.0",
    "d3-geo-projection": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "servor": "^4.0.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "core-js@3.50.0": true
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-path": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "geojson": "^0.5.0",
    "jspdf": "^4.2.1",
    "topojson-client": "^3.1.0"
  }
}

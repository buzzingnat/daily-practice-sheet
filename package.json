{
  "name": "daily-practice-sheet",
  "version": "1.0.0",
  "description": "Generate a daily practice sheet for a selection of various topics.",
  "license": "MIT",
  "author": "Hillary Spratt",
  "sourceType": "module",
  "main": "main.js",
  "engines": {"node": ">=22.12"},
  "type": "module",
  "scripts": {
    "check-node": "node scripts/check-node-version.mjs",
    "predev": "npm run check-node",
    "pretest": "npm run check-node && tsc --noEmit",
    "pretest:watch": "npm run check-node && tsc --noEmit",
    "prebuild": "npm run check-node && tsc --noEmit",
    "prebuild:geo": "npm run check-node && tsc --noEmit",
    "dev:build": "node build.js --watch",
    "dev:server": "servor dist index.html 3000 --reload",
    "dev:types": "tsc --watch --noEmit",
    "dev:test-types": "tsc --watch --noEmit -p tests",
    "dev": "concurrently --kill-others -n \"BUILD,SERVE,TYPES,TEST-TYPES\" -c \"cyan,green,magenta,yellow\" \"npm:dev:build\" \"npm:dev:server\" \"npm:dev:types\" \"npm:dev:test-types\"",
    "build:geo": "ts-node scripts/compile-geography.ts",
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --minify --sourcemap",
    "test:watch": "vitest",
    "test:types": "tsc --noEmit -p tests",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-dsv": "^3.0.7",
    "@types/jsdom": "^30.0.0",
    "concurrently": "^10.0.5",
    "d3": "^7.9.0",
    "d3-geo-projection": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "servor": "^4.0.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "core-js@3.50.0": true
  },
  "dependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-path": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "geojson": "^0.5.0",
    "jspdf": "^4.2.1",
    "topojson-client": "^3.1.0"
  }
}
